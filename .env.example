# Banco lido pelo docker-compose-orbitapi.yml ao subir a imagem. De dentro do container,
# "localhost" é o próprio container: use o IP da máquina ou host.docker.internal
DATABASE_IP=host.docker.internal
DATABASE_PORT=5433
DATABASE_NAME=orbit
DATABASE_USER=postgres
DATABASE_PASSWORD=orbitAPI@2026

# Origens que podem chamar a API pelo navegador (a do OrbitWeb), separadas por vírgula
ORBITAPI_CORS_ORIGENS_PERMITIDAS=http://localhost:9031
